async def send_order_to_supergroup(message: Message, state: FSMContext, bot: Bot, payment_status: str):
    data = await state.get_data()
    service_title = data.get("service_title", "Не указано")

    user = message.from_user
    username = f"@{user.username}" if user.username else "без юзернейма"

    order_text = (
        f"🔔 <b>НОВАЯ ЗАЯВКА</b> [#ID_{user.id}]\n\n"
        f"👤 <b>Клиент:</b> {user.full_name} ({username})\n"
        f"📊 <b>Рекламный источник:</b> <code>{data.get('ad_source')}</code>\n"
        f"🛠 <b>Категория:</b> {service_title}\n"
        f"💰 <b>Условия оплаты:</b> {payment_status}\n"
        f"📝 <b>Описание/ТЗ:</b>\n{data.get('description', 'Без описания')}\n"
    )

    file_id = data.get("file_id")
    media_type = data.get("media_type")
    kb = get_supergroup_order_kb(user.id)

    try:
        if file_id and media_type == "voice":
            await bot.send_voice(SUPERGROUP_ID, voice=file_id, caption=order_text, reply_markup=kb)
        elif file_id and media_type == "audio":
            await bot.send_audio(SUPERGROUP_ID, audio=file_id, caption=order_text, reply_markup=kb)
        elif file_id and media_type == "photo":
            await bot.send_photo(SUPERGROUP_ID, photo=file_id, caption=order_text, reply_markup=kb)
        elif file_id and media_type == "video":
            await bot.send_video(SUPERGROUP_ID, video=file_id, caption=order_text, reply_markup=kb)
        elif file_id and media_type == "document":
            await bot.send_document(SUPERGROUP_ID, document=file_id, caption=order_text, reply_markup=kb)
        else:
            await bot.send_message(SUPERGROUP_ID, text=order_text, reply_markup=kb)
    except Exception as e:
        logging.error(f"Ошибка отправки в супергруппу: {e}")
        await message.answer(
            "⚠️ Произошла ошибка при передаче заявки. Проверьте настройки SUPERGROUP_ID и права бота в группе.",
            reply_markup=get_main_panel_kb()
        )
        return

    ad_source = data.get("ad_source", "Прямой заход (Органика)")
    await state.clear()
    await state.update_data(ad_source=ad_source)

    await message.answer(
        "🎉 <b>Ваша заявка принята и передана в супергруппу!</b>\n\n"
        "Мы уведомим вас в этом чате, как только заказ будет взят в обработку и выполнен.",
        reply_markup=get_main_panel_kb()
    )
    await state.set_state(OrderFlow.choosing_service)


