@router.message(F.chat.id == SUPERGROUP_ID, F.reply_to_message)
async def handle_operator_reply(message: Message, bot: Bot):
    replied = message.reply_to_message
    source_text = replied.caption or replied.text or ""

    match = re.search(r"#ID_(\d+)", source_text)
    if not match:
        return

    client_id = int(match.group(1))
    operator = message.from_user.full_name

    # Сценарий отказа с пояснением причины
    if f"#REJECT_{client_id}" in source_text:
        reason = message.text or message.caption
        if not reason:
            await message.reply("⚠️ Пожалуйста, напишите причину отказа обычным текстом.")
            return

        try:
            await bot.send_message(
                client_id,
                "❌ <b>Ваша заявка отклонена исполнителем.</b>\n\n"
                f"💬 <b>Причина отказа:</b> {reason}\n\n"
                "Вы можете скорректировать данные и отправить новую заявку через кнопки на нижней панели.",
                reply_markup=get_main_panel_kb()
            )
            clean_text = source_text.split("\n\n⚠️ <b>ОЖИДАЕТСЯ ПРИЧИНА ОТКАЗА")[0]
            final_text = (
                f"{clean_text}\n\n"
                f"❌ <b>СТАТУС: ОТКАЗАНО ({operator})</b>\n"
                f"💬 <b>Причина:</b> {reason}"
            )
            await _edit_group_msg(replied, final_text, reply_markup=None)
            await message.reply("✅ Отказ с указанной причиной отправлен клиенту.")
        except Exception as e:
            await message.reply(f"❌ Ошибка при отправке отказа клиенту: {e}")
        return

    # Сценарий отправки готового заказа клиенту с запросом подтверждения приёма
    confirm_prompt = (
        "\n\n👇 Пожалуйста, проверьте результат и нажмите "
        "<b>«✅ Подтвердить приём заказа»</b> на нижней панели."
    )
    confirm_kb = get_confirm_order_panel_kb()

    try:
        if message.document:
            await bot.send_document(
                client_id,
                document=message.document.file_id,
                caption=f"📦 <b>Ваш заказ готов!</b>\n\n{message.caption or 'Готовый файл / архив во вложении.'}{confirm_prompt}",
                reply_markup=confirm_kb
            )
        elif message.audio:
            await bot.send_audio(
                client_id,
                audio=message.audio.file_id,
                caption=f"📦 <b>Ваш заказ готов!</b>\n\n{message.caption or ''}{confirm_prompt}",
                reply_markup=confirm_kb
            )
        elif message.video:
            await bot.send_video(
                client_id,
                video=message.video.file_id,
                caption=f"📦 <b>Ваш заказ готов!</b>\n\n{message.caption or ''}{confirm_prompt}",
                reply_markup=confirm_kb
            )
        elif message.photo:
            await bot.send_photo(
                client_id,
                photo=message.photo[-1].file_id,
                caption=f"📦 <b>Ваш заказ готов!</b>\n\n{message.caption or ''}{confirm_prompt}",
                reply_markup=confirm_kb
            )
        elif message.text:
            await bot.send_message(
                client_id,
                f"📦 <b>Ваш заказ готов!</b>\n\n"
                f"Результат / ссылка на скачивание:\n{message.text}{confirm_prompt}",
                reply_markup=confirm_kb
            )
        else:
            await message.reply("⚠️ Отправьте клиенту документ (ZIP/файл), фото, аудио, видео или текстовую ссылку.")
            return

        await message.reply("✅ Результат доставлен клиенту! Ожидаем от него подтверждения приёма заказа.")
    except Exception as e:
        await message.reply(f"❌ Не удалось отправить результат клиенту: {e}")


