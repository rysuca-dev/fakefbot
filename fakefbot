@router.message(OrderFlow.waiting_review, F.text)
async def handle_review_text(message: Message, state: FSMContext, bot: Bot):
    user = message.from_user
    username = f"@{user.username}" if user.username else "без юзернейма"

    try:
        await bot.send_message(
            SUPERGROUP_ID,
            f"⭐️ <b>НОВЫЙ ОТЗЫВ ОТ КЛИЕНТА</b> [#ID_{user.id}]\n\n"
            f"👤 <b>Клиент:</b> {user.full_name} ({username})\n"
            f"💬 <b>Текст отзыва:</b>\n{message.text}"
        )
    except Exception as e:
        logging.error(f"Ошибка пересылки отзыва в супергруппу: {e}")

    data = await state.get_data()
    ad_source = data.get("ad_source", "Прямой заход (Органика)")
    await state.clear()
    await state.update_data(ad_source=ad_source)

    await message.answer(
        "❤️ <b>Спасибо за ваш отзыв!</b>\n\n"
        "Вы возвращены в главное меню. Выберите нужную категорию на нижней панели:",
        reply_markup=get_main_panel_kb()
    )
    await state.set_state(OrderFlow.choosing_service)


