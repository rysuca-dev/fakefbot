        )
        await _edit_group_msg(callback.message, updated_text, reply_markup=None)
        await callback.answer("Вы взяли заказ в работу!")

        await bot.send_message(
            client_id,
            "👨‍💻 Исполнитель подключился к вашему заказу и начал подготовку материалов!"
        )

    elif mode == "reject":
        updated_text = (
            f"{clean_text}\n\n"
            f"⚠️ <b>ОЖИДАЕТСЯ ПРИЧИНА ОТКАЗА</b> [#REJECT_{client_id}]\n"
